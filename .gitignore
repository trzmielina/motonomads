# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C distributions and build
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
*.env.local
credentials.json
*.key

# Operating System & IDEs
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Output generated files (preserve folder with .gitkeep)
output/*
!output/.gitkeep
temp/
logs/
*.log
